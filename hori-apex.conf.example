# HORI Racing Wheel Apex 플러그인 설정
# 기본 위치: ~/Library/Application Support/hori-apex.conf (게임 시작 때 읽는다 — 바꾼 뒤 게임을 다시 켜거나 콘솔에서 `sdk reinit`)
# Apex 는 270° 휠이라 트럭(900° 이상)보다 훨씬 적게 돈다. 가운데를 둔하게 만들면 직진이 안정된다.
# 게임 설정의 "조향 비선형성"과 겹치면 효과가 너무 세다 — 둘 중 하나만 쓴다.

# 곡선: 1.0 그대로 · 1.5 약간 · 2.0 가운데 둔함(절반 돌리면 25%) · 2.5 많이
steer_curve = 2.0

# 가운데 무시 폭(0 … 0.3). 손을 놓았을 때 흔들리면 0.02 정도
steer_deadzone = 0.0

# 최종 배율(1 미만이면 끝까지 돌려도 덜 꺾인다)
steer_scale = 1.0
